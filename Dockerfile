# استخدام نسخة خفيفة ومستقرة من لغة Node.js
FROM node:18-alpine

# تحديد مجلد العمل داخل حاوية الدوكر
WORKDIR /app

# نسخ ملفات اعتماد المشروع (package.json و package-lock.json) الأول عشان نستفيد من الـ Cache
COPY package*.json ./

# تثبيت الحزم والمكتبات المطلوبة
RUN npm install

# نسخ باقي ملفات المشروع إلى مجلد العمل
COPY . .

# المنفذ اللي هيشتغل عليه التطبيق (لو مشروعك بيستخدم منفذ تاني زي 3000 غيره هنا)
EXPOSE 3000

# الأمر اللي هيشغل التطبيق
CMD ["npm", "start"]

